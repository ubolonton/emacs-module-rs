#!/usr/bin/env bash
#MISE description="Build the guide into a checkout of the GitHub Pages site"
#MISE depends=["guide:highlight-js"]
#USAGE arg "<site_dir>" help="The site's emacs-module-rs directory"
#USAGE arg "<name>" help="Directory to publish to: a crate version, or master"
#USAGE flag "--latest" help="Point latest to this directory"
set -euo pipefail

site_dir=$(realpath "$usage_site_dir")
name=$usage_name
url_path=/emacs-module-rs

MDBOOK_BOOK__TITLE="emacs-module-rs $name" \
    MDBOOK_OUTPUT__HTML__SITE_URL="$url_path/$name/" \
    mdbook build "$MISE_PROJECT_ROOT/docs/guide" --dest-dir "$site_dir/$name"

cd "$site_dir"
if [ "${usage_latest:-false}" = true ]; then
    ln -sfn "$name" latest
fi

# For version-switcher.js: master, then versions, newest first.
{
    if [ -d master ]; then
        echo master
    fi
    find . -maxdepth 1 -type d -regex '\./[0-9]+\.[0-9]+\.[0-9]+' -printf '%f\n' | sort -rV
} | jq -Rn '[inputs]' >versions.json
